# ─── App ────────────────────────────────────────────────────────────────────
# Public base URL of the deployed site (used in WhatsApp links and payment callbacks)
APP_BASE_URL=http://localhost:3000

# Secret used to sign rebook/cancel links and internal tokens. Set a long random string.
APP_SECRET=change-me-to-a-long-random-string

# Secret required by the date-blocking endpoint (POST /api/admin/block).
ADMIN_SECRET=change-me-too

# SQLite database file (defaults to ./data/chalet.db)
# DATABASE_FILE=./data/chalet.db

# ─── Email (SMTP) ───────────────────────────────────────────────────────────
# Used to email guest review submissions to the owner inbox
# (chaletConfig.reviewsEmail). Leave empty to run in mock mode: emails are
# logged and stored in the email_outbox table instead of being sent.
# For Gmail: create an App Password (Google Account → Security →
# 2-Step Verification → App passwords) and use it as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional From header; defaults to SMTP_USER
SMTP_FROM=

# ─── WhatsApp Business (Meta Cloud API) ─────────────────────────────────────
# Leave empty to run in mock mode: messages are logged and stored in the
# whatsapp_outbox table instead of being sent.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token you choose, then paste into the Meta webhook config screen:
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ─── Whish wallet ───────────────────────────────────────────────────────────
# Leave empty to run in mock mode (a local simulated checkout page is used).
WHISH_MERCHANT_ID=
WHISH_API_KEY=
WHISH_WEBHOOK_SECRET=

# ─── Crypto payments (hosted-invoice processor, e.g. NOWPayments) ───────────
# Leave empty to run in mock mode (a local simulated checkout page is used).
# NOTE: crypto refunds are manual — cancellations tell the guest the refund
# will be processed shortly, and the owner settles it by hand.
CRYPTO_API_KEY=
CRYPTO_WEBHOOK_SECRET=

# ─── Bank payment gateway ───────────────────────────────────────────────────
# Leave empty to run in mock mode (a local simulated checkout page is used).
BANK_MERCHANT_ID=
BANK_API_KEY=
BANK_WEBHOOK_SECRET=
